# Optional. Without these the app runs in demo mode on local fixtures.
# Use the publishable (anon) key only. Never put a service_role key in browser code.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Optional. Official store listing URLs; leave unset until the listings are live (the site then says "coming soon").
# The official badge files must be placed in public/badges/ (see docs/product/APP_DISTRIBUTION_AND_PAYMENTS.md).
VITE_APP_STORE_URL=
VITE_PLAY_STORE_URL=
